    "IncrementalSpec": {
      "additionalProperties": false,
      "description": "Incremental execution mode and optional upsert key.",
      "properties": {
        "mode": {
          "enum": [
            "by_unit",
            "by_key"
          ],
          "title": "Mode",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Columns used to keep the newest transformed row in by_key mode.",
          "title": "Key"
        }
      },
      "required": [
        "mode"
      ],
      "title": "IncrementalSpec",
      "type": "object"
    },
    "PythonUdfStep": {
      "additionalProperties": false,
      "description": "Register a user function and append its result as a new column.",
